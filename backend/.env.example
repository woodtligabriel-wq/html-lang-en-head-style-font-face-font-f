# =========================================================================
# MUSE + META | Variáveis de Ambiente & Conexão de Base de Dados e APIs
# =========================================================================

# --- Porta do Servidor ---
PORT=3001

# --- 1. Base de Dados (Deixe em branco para usar SQLite nativo automático) ---
# Exemplo Supabase: postgres://postgres.your-project:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Exemplo PostgreSQL: postgresql://usuario:senha@localhost:5432/muse_db
DATABASE_URL=

# --- 2. Meta WhatsApp Cloud API ---
# Obtenha no painel Meta for Developers -> WhatsApp -> API Setup
META_WABA_ID=109283746592837
META_PHONE_NUMBER_ID=102938475610293
META_ACCESS_TOKEN=EAAG...
META_VERIFY_TOKEN=muse_meta_webhook_secret_2026

# --- 3. Gateway Pix BACEN / PSP ---
# Provedores suportados: EFI_BANK (Gerencianet), ASAAS, MERCADO_PAGO, BACEN_DIRECT
PIX_PROVIDER=EFI_BANK
PIX_KEY=pix-financeiro@empresa.com.br
PIX_CLIENT_ID=Client_Id_prod_...
PIX_CLIENT_SECRET=Client_Secret_prod_...
PIX_WEBHOOK_SECRET=muse_secret_pix_hmac_sha256_2026
PIX_CERT_PEM_PATH=./certs/pix_producao.pem

# --- 4. Governança BSC & Compliance ---
FCR_EXPIRATION_DAYS=7
QUORUM_MIN_TECH_APPROVALS=2
QUORUM_MIN_LEGAL_APPROVALS=1
